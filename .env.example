# Copiez ce fichier en .env. Ne publiez jamais .env.
NODE_ENV=development
# Adresse de l'API Sunu-Market (dépôt sunu-market-api), appelée côté serveur uniquement
API_URL=http://localhost:4000
# Chaîne aléatoire d'au moins 32 caractères pour signer le cookie de session : openssl rand -hex 32
SESSION_SECRET=
# Port du serveur de production (npm start)
PORT=3000
